<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Дневная запись. Ставится скриптом скрипт install_mac.sh с ключом autostart подставит __ROOT__. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>ru.nikolskaya.salon-live</string>
  <key>ProgramArguments</key><array><string>/bin/bash</string><string>__ROOT__/scripts/run_live.sh</string></array>
  <key>WorkingDirectory</key><string>__ROOT__</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>__ROOT__/logs/live.log</string>
  <key>StandardErrorPath</key><string>__ROOT__/logs/live.err</string>
</dict>
</plist>
