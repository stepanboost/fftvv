<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Вечерний отчёт каждый день в 21:00 по часам Mac (часовой пояс Mac — Астрахань). -->
<plist version="1.0">
<dict>
  <key>Label</key><string>ru.nikolskaya.salon-nightly</string>
  <key>ProgramArguments</key><array><string>/bin/bash</string><string>__ROOT__/scripts/run_nightly.sh</string></array>
  <key>WorkingDirectory</key><string>__ROOT__</string>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>21</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>__ROOT__/logs/nightly.log</string>
  <key>StandardErrorPath</key><string>__ROOT__/logs/nightly.err</string>
</dict>
</plist>
