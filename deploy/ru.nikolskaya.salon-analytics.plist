<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Автозапуск на Mac mini: launchctl load ~/Library/LaunchAgents/ru.nikolskaya.salon-analytics.plist -->
<plist version="1.0">
<dict>
  <key>Label</key><string>ru.nikolskaya.salon-analytics</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/salon/.venv/bin/python</string>
    <string>-m</string><string>salon_analytics.pipeline.live</string>
    <string>--config</string><string>/opt/salon/config/salon.yaml</string>
  </array>
  <key>WorkingDirectory</key><string>/opt/salon</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/opt/salon/logs/live.log</string>
  <key>StandardErrorPath</key><string>/opt/salon/logs/live.err</string>
</dict>
</plist>
